{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-radar",
  // OpenNext 핸들러 앞에 엣지 경로(/api/live-feed, ingest)와 5분 크론을 둔 커스텀 진입점
  "main": "worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 완성 피드 스냅샷 저장소 (요청당 1~5행 읽기, KV 쓰기 0건)
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-radar-live", "database_id": "e0d2b5ee-3d01-4abb-8008-649b06e3904e", "migrations_dir": "migrations" }
  ],
  // 계정 Cron 슬롯 5개 중 딱 1개만 사용
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
