# 이 파일을 같은 폴더에 .env.local 로 복사하고 값을 채우면, 코드 수정 없이 샘플 → 실데이터로 바뀝니다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 복사하세요. (anon public 키 — 읽기 전용, RLS 로 보호됨)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (NEXT_PUBLIC_ 붙이지 마세요 — 브라우저로 나가면 안 되는 키) ──────────────
# [원본 쉽게 읽기] 해설을 처음 요청 때 생성해 DB(summaries.easy_original_json)에 캐싱할 때만 쓰입니다.
# 비워 두면 이미 캐시된 해설만 보여주고, 없으면 "생성기 연결 전" 안내가 나옵니다.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# EASY_ORIGINAL_MODEL=claude-haiku-5-5
